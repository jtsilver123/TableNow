# =====================================================================
# TableNow environment configuration
# =====================================================================
# Copy this file to `.env.local` and fill in values to connect live services.
# The app runs fully WITHOUT any of these (it uses an in-browser demo store);
# these only switch on the live Supabase / Stripe / Resend backends.

# Set to "true" to read/write the live Supabase backend instead of the demo store.
NEXT_PUBLIC_USE_SUPABASE=false

# --- Supabase (database + auth) ---
# Project URL and the public anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Used by the booking worker to bypass RLS.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (credit purchases) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price IDs for each credit package (create these in the Stripe dashboard).
STRIPE_PRICE_CREDITS_3=
STRIPE_PRICE_CREDITS_10=
STRIPE_PRICE_CREDITS_25=
STRIPE_PRICE_CREDITS_50=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="TableNow <concierge@yourdomain.com>"

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
