# =====================================================================
# TableNow environment configuration
# =====================================================================
# Copy this file to `.env.local` and fill in values to connect live services.
# The app runs fully WITHOUT any of these (it uses an in-browser demo store);
# these only switch on the live Supabase / Stripe / Resend backends.

# Set to "true" to read/write the live Supabase backend instead of the demo store.
NEXT_PUBLIC_USE_SUPABASE=false

# --- Supabase (database + auth) ---
# Project URL and the public anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Used by the booking worker to bypass RLS.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Live restaurant availability ---
# Keep false for the built-in demo adapters. Set true only after deploying the
# Supabase check-availability Edge Function and enabling Supabase Auth.
NEXT_PUBLIC_USE_LIVE_AVAILABILITY=false
# Optional overrides. By default the app calls:
#   $NEXT_PUBLIC_SUPABASE_URL/functions/v1/check-availability
# with NEXT_PUBLIC_SUPABASE_ANON_KEY as the public API key.
NEXT_PUBLIC_AVAILABILITY_API_URL=
NEXT_PUBLIC_AVAILABILITY_API_KEY=

# The provider values below are SERVER-ONLY Edge Function secrets. Set them
# with `supabase secrets set`; never expose them to the browser or GitHub Pages.
OPENTABLE_CLIENT_ID=
OPENTABLE_CLIENT_SECRET=
OPENTABLE_OAUTH_BASE_URL=https://oauth.opentable.com
# OpenTable supplies the API base URL after approving the partnership.
OPENTABLE_API_BASE_URL=
OPENTABLE_REFERRAL_ID=
# Resy does not publish a public diner availability API. Use only an endpoint
# supplied through an approved Resy partnership.
RESY_PARTNER_AVAILABILITY_URL=
RESY_PARTNER_API_TOKEN=
# Maximum dates queried per provider check (1-31; defaults to 7).
MAX_DATES_PER_CHECK=7
# Local testing only. Production checks require an authenticated Supabase user.
ALLOW_ANONYMOUS_AVAILABILITY=false

# --- Stripe (credit purchases) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price IDs for each credit package (create these in the Stripe dashboard).
STRIPE_PRICE_CREDITS_3=
STRIPE_PRICE_CREDITS_10=
STRIPE_PRICE_CREDITS_25=
STRIPE_PRICE_CREDITS_50=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="TableNow <concierge@yourdomain.com>"

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
